// Página "Cardápio & Estoque" — port completo de ProductsView.tsx, SuppliersView.tsx e CustomersView.tsx
// (+ modais da área). Estado e callbacks no global `CardapioStore` (cardapio_store.slint), ligado em
// `src/pages/cardapio.rs`. Checklist: paridade/cardapio.md.

import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons, Icon } from "../icons.slint";
import { CardapioIcons } from "cardapio_icons.slint";
import { CardapioStore, CdScreen, CdModal, CdProduct, CdCategory } from "cardapio_store.slint";
import { Pill, Btn, IconBtn, Notice } from "cardapio_widgets.slint";
import { ProductEditor } from "cardapio_editor.slint";
import { CardapioModals } from "cardapio_modals.slint";
import { SuppliersScreen, CustomersScreen } from "cardapio_people.slint";

export { CardapioStore }

// Botão da barra de ações secundárias (mesmo tamanho, ícone colorido)
component ActionChip inherits Rectangle {
    in property <image> icon;
    in property <color> tone;
    in property <string> text;
    in property <string> badge;
    in property <color> badge-tone: Theme.available;
    in property <bool> alert;
    in property <bool> busy;
    callback clicked;
    height: 32px;
    width: row.preferred-width + 22px;
    border-radius: 11px;
    opacity: root.busy ? 0.6 : 1;
    background: root.alert ? Theme.danger.with-alpha(touch.has-hover ? 0.22 : 0.12) : (touch.has-hover ? Theme.border : Theme.surface-2);
    border-width: 1px;
    border-color: root.alert ? Theme.danger.with-alpha(0.45) : Theme.border;
    row := HorizontalLayout {
        x: 11px;
        spacing: 6px;
        alignment: center;
        Icon { source: root.busy ? Icons.refresh-cw : root.icon; color: root.alert ? Theme.danger : root.tone; size: 14px; y: (parent.height - self.height) / 2; }
        Text { text: root.text; color: root.alert ? Theme.danger : Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        if root.badge != "": Rectangle {
            y: (parent.height - self.height) / 2;
            height: 16px;
            width: b.preferred-width + 10px;
            border-radius: 5px;
            background: root.alert ? Theme.danger : root.badge-tone.with-alpha(0.18);
            b := Text { text: root.badge; color: root.alert ? #ffffff : root.badge-tone; font-size: 10px; font-weight: 800; font-family: "Menlo"; }
        }
    }
    touch := TouchArea { enabled: !root.busy; clicked => { root.clicked(); } }
}

component TabButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    callback clicked;
    height: 36px;
    width: row.preferred-width + 26px;
    border-radius: 12px;
    background: root.active ? Theme.primary : (touch.has-hover ? Theme.border : transparent);
    row := HorizontalLayout {
        x: 13px;
        spacing: 7px;
        alignment: center;
        Icon { source: root.icon; color: root.active ? Theme.primary-text : Theme.text-muted; size: 15px; y: (parent.height - self.height) / 2; }
        Text { text: root.text; color: root.active ? Theme.primary-text : Theme.text; font-size: 13px; font-weight: 800; vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Chip de categoria com faixa, editar e excluir
component CategoryChip inherits Rectangle {
    in property <CdCategory> data;
    callback pick();
    callback edit();
    callback delete();
    height: 32px;
    width: row.preferred-width + 16px;
    border-radius: 11px;
    background: root.data.active ? Theme.primary : (touch.has-hover ? Theme.border : Theme.surface-2);
    property <color> fg: root.data.active ? Theme.primary-text : Theme.text;
    touch := TouchArea { clicked => { root.pick(); } }
    row := HorizontalLayout {
        x: 12px;
        spacing: 6px;
        alignment: center;
        Text { text: root.data.name; color: root.fg; font-size: 12px; font-weight: 700; vertical-alignment: center; }
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 16px;
            width: r.preferred-width + 8px;
            border-radius: 4px;
            background: root.data.active ? Theme.primary-text.with-alpha(0.18) : Theme.border;
            r := Text { text: root.data.range; color: root.data.active ? Theme.primary-text : Theme.text-muted; font-size: 10px; font-weight: 800; font-family: "Menlo"; }
        }
        Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            background: et.has-hover ? Theme.occupied : transparent;
            Icon { source: Icons.pencil; color: et.has-hover ? #ffffff : root.fg.with-alpha(0.6); size: 12px; }
            et := TouchArea { clicked => { root.edit(); } }
        }
        Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 7px;
            background: dt.has-hover ? Theme.danger : transparent;
            Icon { source: Icons.trash-2; color: dt.has-hover ? #ffffff : root.fg.with-alpha(0.6); size: 12px; }
            dt := TouchArea { clicked => { root.delete(); } }
        }
    }
}

component Th inherits Text {
    color: Theme.text-muted;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.6px;
    vertical-alignment: center;
}

component ProductRowView inherits Rectangle {
    in property <CdProduct> data;
    in property <bool> odd;
    callback edit();
    background: hover.has-hover ? Theme.surface-2.with-alpha(0.6) : transparent;
    height: max(58px, cells.preferred-height);
    hover := TouchArea { }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.surface-2; }
    cells := HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        // Produto
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 3px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.data.name;
                    color: name-touch.has-hover ? Theme.primary : Theme.text;
                    font-size: 13px;
                    font-weight: 800;
                    overflow: elide;
                    name-touch := TouchArea { clicked => { root.edit(); } }
                }
                if root.data.code != "": Pill { text: root.data.code; mono: true; y: (parent.height - self.height) / 2; }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                if root.data.brand != "": Text { text: root.data.brand; color: Theme.primary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                if root.data.supplier != "": Rectangle {
                    height: 18px;
                    width: sr.preferred-width + 10px;
                    border-radius: 5px;
                    background: Theme.available.with-alpha(0.12);
                    border-width: 1px;
                    border-color: Theme.available.with-alpha(0.3);
                    sr := HorizontalLayout {
                        x: 5px;
                        spacing: 3px;
                        Icon { source: CardapioIcons.truck; color: Theme.available; size: 11px; y: (parent.height - self.height) / 2; }
                        Text { text: root.data.supplier; color: Theme.available; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                    }
                }
                if root.data.ean != "": Rectangle {
                    height: 18px;
                    width: er.preferred-width + 10px;
                    border-radius: 5px;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.border;
                    er := HorizontalLayout {
                        x: 5px;
                        spacing: 3px;
                        Icon { source: CardapioIcons.barcode; color: Theme.text-muted; size: 11px; y: (parent.height - self.height) / 2; }
                        Text { text: root.data.ean; color: Theme.text-muted; font-size: 10px; font-family: "Menlo"; vertical-alignment: center; }
                    }
                }
                if root.data.description != "": Text {
                    text: "• " + root.data.description;
                    color: Theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
        }
        // Categoria
        Rectangle {
            width: 120px;
            Rectangle {
                x: 0;
                height: 20px;
                width: min(parent.width, cat.preferred-width + 14px);
                border-radius: 7px;
                background: Theme.surface-2;
                cat := Text { text: root.data.category; color: Theme.text; font-size: 11px; overflow: elide; }
            }
        }
        // Destino KDS
        kds-box := Rectangle {
            width: 86px;
            property <color> tone: root.data.kds == "BAR" ? Theme.closing : Theme.available;
            Rectangle {
                x: 0;
                height: 22px;
                width: kr.preferred-width + 14px;
                border-radius: 11px;
                background: parent.tone.with-alpha(0.12);
                border-width: 1px;
                border-color: parent.tone.with-alpha(0.3);
                kr := HorizontalLayout {
                    x: 7px;
                    spacing: 4px;
                    Icon { source: root.data.kds == "BAR" ? Icons.beer : Icons.chef-hat; color: kds-box.tone; size: 12px; y: (parent.height - self.height) / 2; }
                    Text { text: root.data.kds == "BAR" ? "Bar" : "Cozinha"; color: kds-box.tone; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                }
            }
        }
        // Preço
        VerticalLayout {
            width: 120px;
            alignment: center;
            Text { text: root.data.price; color: Theme.primary; font-size: 13px; font-weight: 800; font-family: "Menlo"; horizontal-alignment: right; }
            if root.data.box != "": HorizontalLayout {
                alignment: end;
                spacing: 3px;
                Icon { source: Icons.package; color: Theme.available; size: 11px; y: (parent.height - self.height) / 2; }
                Text { text: root.data.box; color: Theme.available; font-size: 10px; }
            }
        }
        // Custo
        VerticalLayout {
            width: 110px;
            alignment: center;
            spacing: 3px;
            Text { text: root.data.cost; color: Theme.text-muted; font-size: 12px; font-family: "Menlo"; horizontal-alignment: right; }
            if root.data.margin != "": HorizontalLayout {
                alignment: end;
                Pill {
                    text: root.data.margin;
                    tone: root.data.margin-tone == 0 ? Theme.available : root.data.margin-tone == 1 ? Theme.closing : Theme.danger;
                }
            }
        }
        // Estoque
        stock-box := Rectangle {
            width: 104px;
            property <color> tone: root.data.composed ? Theme.purple : root.data.low ? Theme.danger : Theme.text;
            Rectangle {
                height: 22px;
                width: st.preferred-width + 16px;
                border-radius: 11px;
                background: root.data.composed || root.data.low ? parent.tone.with-alpha(0.14) : Theme.surface-2;
                border-width: root.data.composed || root.data.low ? 1px : 0px;
                border-color: parent.tone.with-alpha(0.3);
                st := HorizontalLayout {
                    x: 8px;
                    spacing: 3px;
                    if root.data.low && !root.data.composed: Icon { source: Icons.triangle-alert; color: Theme.danger; size: 11px; y: (parent.height - self.height) / 2; }
                    Text {
                        text: root.data.composed ? "Composto (Ficha)" : root.data.stock;
                        color: stock-box.tone;
                        font-size: 11px;
                        font-weight: 800;
                        font-family: root.data.composed ? "" : "Menlo";
                        vertical-alignment: center;
                    }
                }
            }
        }
        // Ajuste rápido
        HorizontalLayout {
            width: 92px;
            alignment: end;
            spacing: 4px;
            if !root.data.composed: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 36px;
                height: 26px;
                border-radius: 6px;
                background: m1.has-hover ? Theme.border : Theme.surface-2;
                Text { text: "-1"; color: Theme.text; font-size: 12px; font-family: "Menlo"; }
                m1 := TouchArea { clicked => { CardapioStore.quick-stock(root.data.id, -1); } }
            }
            if !root.data.composed: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 26px;
                border-radius: 6px;
                background: p10.has-hover ? Theme.border : Theme.surface-2;
                Text { text: "+10"; color: Theme.primary; font-size: 12px; font-weight: 800; font-family: "Menlo"; }
                p10 := TouchArea { clicked => { CardapioStore.quick-stock(root.data.id, 10); } }
            }
        }
        // Ações
        HorizontalLayout {
            width: 136px;
            alignment: center;
            spacing: 2px;
            IconBtn { y: (parent.height - self.height) / 2; icon: CardapioIcons.history; hover-tone: Theme.purple; clicked => { CardapioStore.history(root.data.id); } }
            IconBtn { y: (parent.height - self.height) / 2; icon: CardapioIcons.copy; hover-tone: Theme.primary; clicked => { CardapioStore.duplicate-product(root.data.id); } }
            IconBtn { y: (parent.height - self.height) / 2; icon: Icons.pencil; clicked => { root.edit(); } }
            IconBtn { y: (parent.height - self.height) / 2; icon: Icons.trash-2; hover-tone: Theme.danger; clicked => { CardapioStore.delete-product(root.data.id); } }
        }
    }
}

component ProductsList inherits Rectangle {
    background: Theme.bg;
    VerticalLayout {
        padding: 16px;
        padding-top: 4px;
        spacing: 12px;

        // Cabeçalho
        Rectangle {
            background: Theme.surface;
            border-radius: 22px;
            border-width: 1px;
            border-color: Theme.surface-2;
            height: head.preferred-height;
            head := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 16px;
                        background: Theme.primary.with-alpha(0.12);
                        border-width: 1px;
                        border-color: Theme.primary.with-alpha(0.25);
                        Icon { source: Icons.utensils-crossed; color: Theme.primary; size: 20px; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: "Cardápio & Estoque"; color: Theme.text; font-size: 20px; font-weight: 900; }
                        Text { text: "Controle de preços, códigos internos, EAN de barras e tributação fiscal"; color: Theme.text-muted; font-size: 12px; }
                    }
                    Btn {
                        y: (parent.height - self.height) / 2;
                        text: "Novo Produto";
                        icon: Icons.plus;
                        has-icon: true;
                        fill: Theme.primary;
                        tone: Theme.primary-text;
                        weight: 900;
                        clicked => { CardapioStore.new-product(); }
                    }
                }
                Rectangle { height: 1px; background: Theme.surface-2; }
                Flickable {
                    height: 34px;
                    content-width: actions.preferred-width;
                    interactive: true;
                    actions := HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        ActionChip { icon: CardapioIcons.chart-column; tone: Theme.purple; text: "Relatório de Estoque"; clicked => { CardapioStore.open-report(); } }
                        ActionChip { icon: CardapioIcons.cloud-upload; tone: Theme.occupied; text: "Importar XML"; clicked => { CardapioStore.import-xml(); } }
                        ActionChip { icon: Icons.sparkles; tone: Theme.primary; text: "Organizar Bar/Cozinha"; busy: CardapioStore.organizing; clicked => { CardapioStore.organize(); } }
                        ActionChip {
                            icon: CardapioIcons.truck;
                            tone: Theme.available;
                            text: "Fornecedores";
                            badge: CardapioStore.supplier-count > 0 ? CardapioStore.supplier-count : "";
                            clicked => { CardapioStore.open-suppliers(); }
                        }
                        ActionChip { icon: Icons.list-checks; tone: Theme.primary; text: "Adicionais e Perguntas"; clicked => { CardapioStore.open-modifiers(); } }
                        ActionChip { icon: CardapioIcons.badge-percent; tone: Theme.danger; text: "Promoções do Dia"; clicked => { CardapioStore.open-promotions(); } }
                        ActionChip { icon: Icons.qr-code; tone: Theme.primary; text: "Cardápio Digital"; clicked => { CardapioStore.open-menu-items(); } }
                        ActionChip { icon: CardapioIcons.clipboard-list; tone: Theme.occupied; text: "Folha de Balanço (PDF)"; clicked => { CardapioStore.open-sheet(); } }
                        ActionChip { icon: Icons.tag; tone: Theme.purple; text: "Nova Categoria"; clicked => { CardapioStore.new-category(); } }
                        ActionChip {
                            icon: Icons.tag;
                            tone: Theme.occupied;
                            text: CardapioStore.backfilling ? "Gerando..." : "# Gerar Códigos";
                            busy: CardapioStore.backfilling;
                            clicked => { CardapioStore.backfill(); }
                        }
                        ActionChip {
                            icon: Icons.triangle-alert;
                            tone: Theme.closing;
                            text: CardapioStore.fixing ? "Corrigindo..." : "Corrigir Duplicados";
                            alert: CardapioStore.duplicate-count > 0;
                            badge: CardapioStore.duplicate-count > 0 ? CardapioStore.duplicate-count : "";
                            busy: CardapioStore.fixing;
                            clicked => { CardapioStore.fix-duplicates(); }
                        }
                    }
                }
            }
        }

        // Filtros
        Rectangle {
            background: Theme.surface;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.surface-2;
            height: filters.preferred-height;
            filters := VerticalLayout {
                padding: 12px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    Icon { source: Icons.search; color: Theme.text-muted; size: 16px; y: (parent.height - self.height) / 2; }
                    LineEdit {
                        height: 38px;
                        horizontal-stretch: 1;
                        placeholder-text: "Buscar por nome, código interno (#BEB-01), EAN/barras, marca ou fornecedor...";
                        text <=> CardapioStore.search;
                        edited => { CardapioStore.search-changed(); }
                    }
                }
                Flickable {
                    height: 34px;
                    content-width: chips.preferred-width;
                    chips := HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Rectangle {
                            height: 32px;
                            width: all.preferred-width + 24px;
                            border-radius: 11px;
                            background: CardapioStore.all-categories ? Theme.primary : (at.has-hover ? Theme.border : Theme.surface-2);
                            all := Text {
                                text: "Todas (" + CardapioStore.total-count + ")";
                                color: CardapioStore.all-categories ? Theme.primary-text : Theme.text;
                                font-size: 12px;
                                font-weight: 700;
                            }
                            at := TouchArea { clicked => { CardapioStore.category-picked("ALL"); } }
                        }
                        for cat in CardapioStore.categories: CategoryChip {
                            data: cat;
                            pick => { CardapioStore.category-picked(cat.id); }
                            edit => { CardapioStore.category-edit(cat.id); }
                            delete => { CardapioStore.category-delete(cat.id); }
                        }
                    }
                }
            }
        }

        // Alerta de códigos duplicados
        if CardapioStore.duplicate-count > 0: Rectangle {
            background: Theme.danger.with-alpha(0.1);
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.danger.with-alpha(0.35);
            height: dup.preferred-height;
            dup := HorizontalLayout {
                padding: 14px;
                spacing: 12px;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px;
                    background: Theme.danger.with-alpha(0.15);
                    Icon { source: Icons.triangle-alert; color: Theme.danger; size: 18px; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Atenção: Detectamos produtos com numeração interna duplicada (" + CardapioStore.duplicate-count + " produtos)";
                        color: Theme.danger;
                        font-size: 13px;
                        font-weight: 900;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Isso acontece quando categorias compartilhavam a mesma faixa inicial (#1001). Clique no botão ao lado para renumerar e dar códigos exclusivos a cada um.";
                        color: Theme.danger.with-alpha(0.85);
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                Btn {
                    y: (parent.height - self.height) / 2;
                    text: CardapioStore.fixing ? "Corrigindo..." : "⚡ Corrigir Numerações Agora";
                    fill: Theme.danger;
                    tone: #ffffff;
                    weight: 900;
                    busy: CardapioStore.fixing;
                    clicked => { CardapioStore.fix-duplicates(); }
                }
            }
        }

        // Tabela
        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface;
            border-radius: 22px;
            border-width: 1px;
            border-color: Theme.surface-2;
            clip: true;
            VerticalLayout {
                Rectangle {
                    height: 38px;
                    background: Theme.surface-2.with-alpha(0.45);
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 10px;
                        Th { text: "PRODUTO"; horizontal-stretch: 1; }
                        Th { text: "CATEGORIA"; width: 120px; }
                        Th { text: "DESTINO KDS"; width: 86px; }
                        Th { text: "PREÇO VENDA"; width: 120px; horizontal-alignment: right; }
                        Th { text: "CUSTO"; width: 110px; horizontal-alignment: right; }
                        Th { text: "ESTOQUE"; width: 104px; }
                        Th { text: "AJUSTE RÁPIDO"; width: 92px; horizontal-alignment: right; }
                        Th { text: "AÇÕES"; width: 136px; horizontal-alignment: center; }
                    }
                }
                if CardapioStore.products.length > 0: ListView {
                    vertical-stretch: 1;
                    for p[i] in CardapioStore.products: ProductRowView {
                        data: p;
                        odd: mod(i, 2) == 1;
                        edit => { CardapioStore.edit-product(p.id); }
                    }
                }
                if CardapioStore.products.length == 0 && !CardapioStore.loading: Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: 16px;
                                background: Theme.surface-2;
                                Icon {
                                    source: CardapioStore.search-is-barcode ? CardapioIcons.barcode : Icons.search;
                                    color: CardapioStore.search-is-barcode ? Theme.primary : Theme.text-muted;
                                    size: 24px;
                                }
                            }
                        }
                        Text {
                            text: "Nenhum produto cadastrado encontrado" + (CardapioStore.search != "" ? " para \"" + CardapioStore.search + "\"" : "");
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 800;
                            horizontal-alignment: center;
                        }
                        if CardapioStore.search-is-barcode: Text {
                            text: "Este código de barras ainda não está no cardápio. Deseja cadastrá-lo agora com preenchimento automático?";
                            color: Theme.text-muted;
                            font-size: 12px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: center;
                            if CardapioStore.search-is-barcode: Btn {
                                text: "Cadastrar Código " + CardapioStore.search;
                                icon: Icons.sparkles;
                                has-icon: true;
                                fill: Theme.primary;
                                tone: Theme.primary-text;
                                weight: 900;
                                clicked => { CardapioStore.register-barcode(); }
                            }
                            if !CardapioStore.search-is-barcode: Btn {
                                text: "+ Cadastrar Novo Produto";
                                tone: Theme.primary;
                                clicked => { CardapioStore.new-product(); }
                            }
                        }
                    }
                }
            }
        }
    }

}

export component CardapioAreaPage inherits Rectangle {
    background: Theme.bg;
    init => { CardapioStore.shown(); }
    VerticalLayout {
        // Abas da área (no original: Cardápio e Fornecedores eram telas do menu; Clientes (Fiado) fica na Retaguarda)
        if CardapioStore.screen != CdScreen.editor: HorizontalLayout {
            padding: 16px;
            padding-bottom: 8px;
            spacing: 6px;
            alignment: start;
            TabButton { text: "Produtos"; icon: Icons.utensils-crossed; active: CardapioStore.screen == CdScreen.products; clicked => { CardapioStore.show-screen(CdScreen.products); } }
            TabButton { text: "Fornecedores"; icon: CardapioIcons.truck; active: CardapioStore.screen == CdScreen.suppliers; clicked => { CardapioStore.show-screen(CdScreen.suppliers); } }
        }
        if CardapioStore.screen == CdScreen.products: ProductsList { vertical-stretch: 1; }
        if CardapioStore.screen == CdScreen.editor: ProductEditor { vertical-stretch: 1; }
        if CardapioStore.screen == CdScreen.suppliers: SuppliersScreen { vertical-stretch: 1; }
        if CardapioStore.screen == CdScreen.customers: CustomersScreen { vertical-stretch: 1; }
    }
    CardapioModals { width: 100%; height: 100%; }
}
