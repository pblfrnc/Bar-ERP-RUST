            spacing: 8px;
            padding-top: 6px;
            Btn { horizontal-stretch: 1; text: "Cancelar"; clicked => { CardapioStore.close-modal(); } }
            Btn { horizontal-stretch: 1; text: "Vincular Agora"; fill: Theme.primary; tone: Theme.primary-text; weight: 800; clicked => { CardapioStore.q-save(); } }
        }
    }
}

// ---------- Fornecedor completo ----------
component SupplierFormSheet inherits Sheet {
    panel-width: 560px;
    icon: CardapioIcons.truck;
    tone: Theme.available;
    title: CardapioStore.sf-editing ? "Editar Fornecedor" : "Novo Fornecedor";
    close => { CardapioStore.close-modal(); }
    ScrollView {
        VerticalLayout {
            padding: 20px;
            spacing: 8px;
            ErrorBox { }
            FieldLabel { text: "RAZÃO SOCIAL / NOME PRINCIPAL *"; }
            LineEdit { height: 40px; placeholder-text: "Ex: Cervejaria Ambev S.A. ou Distribuidora Modelo"; text <=> CardapioStore.sf-name; }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    FieldLabel { text: "NOME FANTASIA"; }
                    LineEdit { height: 40px; placeholder-text: "Ex: Ambev Chopp"; text <=> CardapioStore.sf-trade; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    HorizontalLayout {
                        FieldLabel { text: "CNPJ OU CPF"; horizontal-stretch: 1; }
                        Text {
                            text: CardapioStore.sf-cnpj-busy ? "Consultando..." : "Consultar CNPJ";
                            color: Theme.available;
                            font-size: 13px;
                            font-weight: 800;
                            TouchArea { clicked => { CardapioStore.sf-cnpj(); } }
                        }
                    }
                    LineEdit { height: 40px; placeholder-text: "00.000.000/0000-00"; text <=> CardapioStore.sf-doc; }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    FieldLabel { text: "TELEFONE / WHATSAPP"; }
                    LineEdit { height: 40px; placeholder-text: "(11) 98888-7777"; text <=> CardapioStore.sf-phone; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    FieldLabel { text: "INSCRIÇÃO ESTADUAL (IE)"; }
                    LineEdit { height: 40px; placeholder-text: "Ex: 123456789"; text <=> CardapioStore.sf-ie; }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    FieldLabel { text: "E-MAIL"; }
                    LineEdit { height: 40px; placeholder-text: "pedidos@fornecedor.com.br"; text <=> CardapioStore.sf-email; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    FieldLabel { text: "CONTATO / VENDEDOR"; }
                    LineEdit { height: 40px; placeholder-text: "Ex: Carlos Representante"; text <=> CardapioStore.sf-contact; }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 2;
                    spacing: 4px;
                    FieldLabel { text: "CIDADE"; }
                    LineEdit { height: 40px; placeholder-text: "Ex: São Paulo"; text <=> CardapioStore.sf-city; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    FieldLabel { text: "UF"; }
                    LineEdit { height: 40px; placeholder-text: "SP"; text <=> CardapioStore.sf-uf; }
                }
            }
            FieldLabel { text: "ENDEREÇO"; }
            LineEdit { height: 40px; placeholder-text: "Rua, número, bairro..."; text <=> CardapioStore.sf-address; }
            FieldLabel { text: "OBSERVAÇÕES / CONDIÇÕES COMERCIAIS"; }
            TextEdit { height: 64px; wrap: word-wrap; placeholder-text: "Ex: Entrega às terças-feiras. Pedido mínimo R$ 500. Boleto 28 dias."; text <=> CardapioStore.sf-notes; }
            HorizontalLayout {
                spacing: 8px;
                padding-top: 6px;
                Btn { horizontal-stretch: 1; text: "Cancelar"; clicked => { CardapioStore.close-modal(); } }
                Btn {
                    horizontal-stretch: 1;
                    text: CardapioStore.sf-editing ? "Atualizar Fornecedor" : "Salvar Fornecedor";
                    fill: Theme.available;
                    tone: Theme.primary-text;
                    weight: 800;
                    clicked => { CardapioStore.sf-save(); }
                }
            }
        }
    }
}

