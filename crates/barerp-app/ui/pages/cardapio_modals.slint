component PayDebtSheet inherits Sheet {
    panel-width: 420px;
    icon: Icons.hand-coins;
    tone: Theme.available;
    title: "Receber Fiado";
    subtitle: CardapioStore.pd-name + " · deve " + CardapioStore.pd-debt;
    close => { CardapioStore.close-modal(); }
    VerticalLayout {
        padding: 20px;
        spacing: 8px;
        ErrorBox { }
        FieldLabel { text: "VALOR RECEBIDO (R$)"; }
        Field { big: true; prefix: "R$"; placeholder: "0,00"; text <=> CardapioStore.pd-amount; accepted => { CardapioStore.pd-save(); } }
        HorizontalLayout {
            spacing: 8px;
            padding-top: 6px;
            Btn { horizontal-stretch: 1; text: "Cancelar"; clicked => { CardapioStore.close-modal(); } }
