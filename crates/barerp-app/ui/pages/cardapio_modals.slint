        padding: 20px;
        spacing: 8px;
        ErrorBox { }
        FieldLabel { text: "RAZÃO SOCIAL / NOME *"; }
        LineEdit { height: 40px; placeholder-text: "Ex: Cervejaria Heineken do Brasil"; text <=> CardapioStore.q-name; }
        FieldLabel { text: "NOME FANTASIA"; }
        LineEdit { height: 40px; placeholder-text: "Ex: Heineken"; text <=> CardapioStore.q-trade; }
        FieldLabel { text: "CNPJ OU CPF (OPCIONAL)"; }
        LineEdit { height: 40px; placeholder-text: "00.000.000/0000-00"; text <=> CardapioStore.q-doc; }
        FieldLabel { text: "TELEFONE / WHATSAPP (OPCIONAL)"; }
