// Modais da área Cardápio & Estoque: categoria, histórico de preços, relatório de estoque, NCM, folha de
// balanço, fornecedor rápido/completo, cliente, receber fiado, adicionais (ModifierGroupsManager),
// promoções (PromotionsManager), itens do cardápio digital (DigitalMenuItemsModal) e confirmação.

import { LineEdit, ComboBox, ScrollView, TextEdit, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icons, Icon } from "../icons.slint";
import { CardapioIcons } from "cardapio_icons.slint";
import { CardapioStore, CdModal, CdHistory, CdReportCat, CdModGroup, CdModOption, CdPromo, CdChoice, CdMenuRow } from "cardapio_store.slint";
import { Pill, Btn, CloseX, FieldLabel, Hint, Toggle, MiniChip, Notice, Field, Check, Sheet } from "cardapio_widgets.slint";

component ErrorBox inherits Notice {
    text: CardapioStore.modal-error;
    tone: Theme.danger;
}

// ---------- Categoria ----------
component CategorySheet inherits Sheet {
    panel-width: 480px;
    icon: Icons.tag;
    title: CardapioStore.c-editing ? "Editar Categoria" : "Nova Categoria";
    subtitle: CardapioStore.c-subtitle;
    close => { CardapioStore.close-modal(); }
    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        ErrorBox { }
        FieldLabel { text: "NOME DA CATEGORIA *"; }
        LineEdit { height: 42px; placeholder-text: "Ex: Alimentos, Lanches, Cervejas, Porções..."; text <=> CardapioStore.c-name; accepted => { CardapioStore.c-save(); } }
        HorizontalLayout {
            FieldLabel { text: "FAIXA NUMÉRICA INICIAL (CÓDIGO INTERNO) *"; horizontal-stretch: 1; }
            Text { text: "#" + (CardapioStore.c-code-start != "" ? CardapioStore.c-code-start : "1001") + "+"; color: Theme.primary; font-size: 13px; font-weight: 800; font-family: "Menlo"; }
        }
        LineEdit { height: 42px; input-type: number; placeholder-text: "Ex: 1001, 2001, 5001..."; text <=> CardapioStore.c-code-start; }
        FieldLabel { text: "ATALHOS DE FAIXAS RECOMENDADAS:"; }
        for line in [
            [{ code: "1001", label: "1001 (Cozinha/Pratos)" }, { code: "2001", label: "2001 (Alimentos/Porções)" }, { code: "3001", label: "3001 (Pizzas/Massas)" }],
            [{ code: "4001", label: "4001 (Sucos/Refrigerantes)" }, { code: "5001", label: "5001 (Bar/Bebidas/Chopp)" }],
            [{ code: "6001", label: "6001 (Doces/Chicletes/Balas)" }, { code: "7001", label: "7001 (Combos/Especiais)" }],
        ]: HorizontalLayout {
            spacing: 5px;
            alignment: start;
            for preset in line: MiniChip {
                text: preset.label;
                mono: true;
                active: CardapioStore.c-code-start == preset.code;
                clicked => { CardapioStore.c-code-start = preset.code; }
            }
        }
        Hint { text: "Novos produtos cadastrados nesta categoria receberão numeração a partir de #" + (CardapioStore.c-code-start != "" ? CardapioStore.c-code-start : "1001") + "."; }
        if CardapioStore.c-editing: Rectangle {
            height: ren.preferred-height;
            border-radius: 12px;
            background: Theme.primary.with-alpha(0.1);
            border-width: 1px;
            border-color: Theme.primary.with-alpha(0.35);
            ren := HorizontalLayout {
                padding: 12px;
                spacing: 10px;
                Check { checked: CardapioStore.c-renumber; clicked => { CardapioStore.c-renumber = !CardapioStore.c-renumber; } }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: "Renumerar produtos existentes desta categoria"; color: Theme.text; font-size: 13px; font-weight: 800; }
                    Text {
                        text: "Atualiza os códigos internos de todos os produtos desta categoria para ficarem no intervalo sequencial iniciando em #" + (CardapioStore.c-code-start != "" ? CardapioStore.c-code-start : "1001") + ".";
                        color: Theme.text-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            padding-top: 4px;
            Btn { horizontal-stretch: 1; text: "Cancelar"; clicked => { CardapioStore.close-modal(); } }
            Btn { horizontal-stretch: 1; text: CardapioStore.c-editing ? "Salvar Alterações" : "Criar Categoria"; fill: Theme.primary; tone: Theme.primary-text; weight: 800; clicked => { CardapioStore.c-save(); } }
        }
    }
}

// ---------- Histórico de preços ----------
component HistoryCard inherits Rectangle {
    in property <CdHistory> data;
    height: col.preferred-height;
    background: Theme.bg;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.surface-2;
    col := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Text { text: root.data.date; color: Theme.text; font-size: 13px; font-weight: 800; font-family: "Menlo"; horizontal-stretch: 1; vertical-alignment: center; }
            Pill { text: "Por: " + root.data.by; }
            Pill { text: root.data.xml ? "Entrada NF-e (XML)" : "Edição Manual"; tone: root.data.xml ? Theme.closing : Theme.purple; }
        }
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1;
                height: sale.preferred-height;
                background: Theme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface-2;
                sale := VerticalLayout {
                    padding: 10px;
                    spacing: 3px;
                    Text { text: "PREÇO DE VENDA"; color: Theme.text-muted; font-size: 12px; font-weight: 800; }
                    HorizontalLayout {
                        Text { text: root.data.old-price; color: Theme.text-muted; font-size: 13px; font-family: "Menlo"; stroke: Theme.text-muted; horizontal-stretch: 1; }
                        Icon { source: CardapioIcons.arrow-right; color: Theme.text-muted; size: 13px; y: (parent.height - self.height) / 2; }
                        Text { text: root.data.new-price; color: Theme.text; font-size: 13px; font-weight: 900; font-family: "Menlo"; horizontal-stretch: 1; horizontal-alignment: right; }
                    }
                    Text {
                        text: root.data.price-diff;
                        color: root.data.price-dir > 0 ? Theme.available : root.data.price-dir < 0 ? Theme.danger : Theme.text-muted;
                        font-size: 12px;
                        font-weight: 800;
                        horizontal-alignment: right;
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: cost.preferred-height;
                background: Theme.surface;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface-2;
                cost := VerticalLayout {
                    padding: 10px;
                    spacing: 3px;
                    Text { text: "PREÇO DE CUSTO"; color: Theme.text-muted; font-size: 12px; font-weight: 800; }
                    HorizontalLayout {
                        Text { text: root.data.old-cost; color: Theme.text-muted; font-size: 13px; font-family: "Menlo"; horizontal-stretch: 1; }
                        Icon { source: CardapioIcons.arrow-right; color: Theme.text-muted; size: 13px; y: (parent.height - self.height) / 2; }
                        Text { text: root.data.new-cost; color: Theme.text; font-size: 13px; font-weight: 800; font-family: "Menlo"; horizontal-stretch: 1; horizontal-alignment: right; }
                    }
                    Text {
                        text: root.data.cost-diff;
                        color: root.data.cost-dir > 0 ? Theme.danger : root.data.cost-dir < 0 ? Theme.available : Theme.text-muted;
                        font-size: 12px;
                        font-weight: 800;
                        horizontal-alignment: right;
                    }
                }
            }
        }
        if root.data.chave != "": Text { text: "Chave NF-e: " + root.data.chave; color: Theme.text-muted; font-size: 12px; font-family: "Menlo"; overflow: elide; }
    }
}

component HistorySheet inherits Sheet {
    panel-width: 680px;
    panel-height: 620px;
    icon: CardapioIcons.history;
    tone: Theme.purple;
    title: "Histórico de Alterações de Preço";
    subtitle: CardapioStore.h-subtitle;
    close => { CardapioStore.close-modal(); }
    VerticalLayout {
        vertical-stretch: 1;
        padding: 18px;
        spacing: 10px;
        if CardapioStore.h-loading: Text { vertical-stretch: 1; text: "Carregando histórico..."; color: Theme.text-muted; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        if !CardapioStore.h-loading && CardapioStore.h-rows.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout { alignment: center; Icon { source: CardapioIcons.history; color: Theme.text-muted.with-alpha(0.5); size: 32px; } }
            Text { text: "Nenhuma alteração registrada ainda"; color: Theme.text; font-size: 13px; font-weight: 800; horizontal-alignment: center; }
            Text {
                text: "As alterações manuais e importações de XML aparecerão registradas aqui com responsável e variações.";
                color: Theme.text-muted;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if !CardapioStore.h-loading && CardapioStore.h-rows.length > 0: ListView {
            vertical-stretch: 1;
            for h in CardapioStore.h-rows: VerticalLayout {
                padding-bottom: 8px;
                HistoryCard { data: h; }
            }
        }
        HorizontalLayout {
            alignment: end;
            Btn { text: "Fechar"; clicked => { CardapioStore.close-modal(); } }
        }
    }
}

// ---------- Relatório de estoque ----------
component ReportTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <color> tone: Theme.text;
    in property <bool> highlight;
    horizontal-stretch: 1;
    height: 90px;
    background: root.highlight ? Theme.purple.with-alpha(0.1) : Theme.bg;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.highlight ? Theme.purple.with-alpha(0.35) : Theme.surface-2;
    VerticalLayout {
        padding: 14px;
        spacing: 3px;
        Text { text: root.label; color: root.highlight ? Theme.purple : Theme.text-muted; font-size: 12px; font-weight: 800; letter-spacing: 0.5px; }
        Text { text: root.value; color: root.tone; font-size: 17px; font-weight: 900; font-family: "Menlo"; }
        Text { text: root.sub; color: root.highlight ? Theme.purple : Theme.text-muted; font-size: 12px; }
    }
}

component ReportSheet inherits Sheet {
    panel-width: 900px;
    panel-height: 640px;
    icon: CardapioIcons.chart-column;
    tone: Theme.purple;
    title: "Relatório de Estoque & Lucro Previsto";
    subtitle: "Posição consolidada a preço de custo e venda, e lucratividade total e por categoria";
    close => { CardapioStore.close-modal(); }
    VerticalLayout {
        vertical-stretch: 1;
        padding: 18px;
        spacing: 12px;
        if CardapioStore.r-loading: Text { vertical-stretch: 1; text: "Calculando valores do inventário..."; color: Theme.text-muted; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        if !CardapioStore.r-loading && CardapioStore.r-failed: Text { vertical-stretch: 1; text: "Falha ao carregar relatório."; color: Theme.text-muted; horizontal-alignment: center; vertical-alignment: center; }
        if !CardapioStore.r-loading && !CardapioStore.r-failed: HorizontalLayout {
            spacing: 10px;
            ReportTile { label: "TOTAL A CUSTO"; value: CardapioStore.r-cost; sub: CardapioStore.r-cost-sub; }
            ReportTile { label: "TOTAL A VENDA"; value: CardapioStore.r-sale; sub: CardapioStore.r-sale-sub; tone: Theme.available; }
            ReportTile { label: "LUCRO PREVISTO TOTAL"; value: CardapioStore.r-profit; sub: "Venda - Custo"; tone: Theme.purple; highlight: true; }
            ReportTile { label: "MARGEM MÉDIA"; value: CardapioStore.r-margin; sub: "Rentabilidade Geral"; tone: Theme.primary; }
        }
        if !CardapioStore.r-loading && !CardapioStore.r-failed: Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.surface-2;
            clip: true;
            VerticalLayout {
                Rectangle {
                    height: 42px;
                    background: Theme.surface-2.with-alpha(0.45);
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;
                        Icon { source: Icons.tag; color: Theme.primary; size: 15px; y: (parent.height - self.height) / 2; }
                        Text { text: "LUCRO PREVISTO AGRUPADO POR CATEGORIA"; color: Theme.text; font-size: 13px; font-weight: 900; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: CardapioStore.r-count; color: Theme.text-muted; font-size: 13px; vertical-alignment: center; }
                    }
                }
                HorizontalLayout {
                    height: 32px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    for h in ["CATEGORIA", "PRODUTOS", "UNIDADES", "ESTOQUE CUSTO", "ESTOQUE VENDA", "LUCRO PREVISTO", "MARGEM"]: Text {
                        horizontal-stretch: h == "CATEGORIA" ? 2 : 1;
                        text: h;
                        color: Theme.text-muted;
                        font-size: 12px;
                        font-weight: 800;
                        vertical-alignment: center;
                        horizontal-alignment: h == "CATEGORIA" ? left : h == "PRODUTOS" || h == "UNIDADES" || h == "MARGEM" ? center : right;
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for r in CardapioStore.r-rows: Rectangle {
                        height: 38px;
                        Rectangle { y: 0; height: 1px; background: Theme.surface-2; }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Text { horizontal-stretch: 2; text: r.name; color: Theme.text; font-size: 13px; font-weight: 800; vertical-alignment: center; overflow: elide; }
                            Text { horizontal-stretch: 1; text: r.items; color: Theme.text-muted; font-size: 13px; font-family: "Menlo"; horizontal-alignment: center; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: r.units; color: Theme.text-muted; font-size: 13px; font-family: "Menlo"; horizontal-alignment: center; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: r.cost; color: Theme.text; font-size: 13px; font-family: "Menlo"; horizontal-alignment: right; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: r.sale; color: Theme.available; font-size: 13px; font-weight: 800; font-family: "Menlo"; horizontal-alignment: right; vertical-alignment: center; }
                            Text { horizontal-stretch: 1; text: r.profit; color: Theme.purple; font-size: 13px; font-weight: 900; font-family: "Menlo"; horizontal-alignment: right; vertical-alignment: center; }
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Pill { y: (parent.height - self.height) / 2; text: r.margin; tone: r.tone == 0 ? Theme.available : r.tone == 1 ? Theme.closing : Theme.danger; }
                            }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Btn { text: "Fechar Relatório"; clicked => { CardapioStore.close-modal(); } }
        }
    }
}

// ---------- Consulta de NCM ----------
component NcmSheet inherits Sheet {
    panel-width: 680px;
    icon: CardapioIcons.book-open;
    tone: Theme.purple;
    title: "Consulta Oficial de NCM";
    subtitle: "Classificação fiscal e alíquotas oficiais da Receita Federal";
    close => { CardapioStore.close-modal(); }
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                height: 42px;
                horizontal-stretch: 1;
                placeholder-text: "Nome do produto (ex: cerveja, refrigerante) ou código NCM";
                text <=> CardapioStore.n-code;
                accepted => { CardapioStore.n-search(); }
            }
            Btn {
                h: 42px;
                text: "Consultar";
                fill: Theme.purple;
                tone: #ffffff;
                busy: CardapioStore.n-loading;
                enabled: CardapioStore.n-code.character-count >= 2;
                clicked => { CardapioStore.n-search(); }
            }
        }
        if CardapioStore.n-results.length == 0: FieldLabel { text: "ATALHOS COMUNS NO BAR & RESTAURANTE"; }
        if CardapioStore.n-results.length == 0: VerticalLayout {
        spacing: 12px;
        for line in [
            [{ code: "22030000", label: "Cervejas e Chopes" }, { code: "22021000", label: "Refrigerantes" }, { code: "22011000", label: "Águas Minerais" }],
            [{ code: "22084000", label: "Cachaças e Aguardentes" }, { code: "22083020", label: "Whiskies" }, { code: "22086000", label: "Vodkas" }],
            [{ code: "22085000", label: "Gins" }, { code: "22042100", label: "Vinhos de Mesa" }, { code: "21069090", label: "Lanches e Porções" }],
            [{ code: "19059090", label: "Pastéis e Salgados" }, { code: "24022000", label: "Cigarros e Tabacaria" }],
        ]: HorizontalLayout {
            spacing: 5px;
            alignment: start;
            for q in line: Rectangle {
                height: 26px;
                width: qr.preferred-width + 16px;
                border-radius: 8px;
                background: qt.has-hover ? Theme.border : Theme.surface-2;
                qr := HorizontalLayout {
                    x: 8px;
                    spacing: 4px;
                    Text { text: q.code; color: Theme.purple; font-size: 13px; font-weight: 800; font-family: "Menlo"; vertical-alignment: center; }
                    Text { text: "— " + q.label; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                }
                qt := TouchArea { clicked => { CardapioStore.n-quick(q.code); } }
            }
        }
        }
        Notice { text: CardapioStore.n-error; tone: Theme.danger; }
        if CardapioStore.n-has-result: Rectangle {
            height: res.preferred-height;
            background: Theme.bg;
            border-radius: 16px;
            border-width: 1px;
            border-color: Theme.surface-2;
            res := VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 6px;
                    Icon { source: Icons.circle-check; color: Theme.available; size: 16px; y: (parent.height - self.height) / 2; }
                    Text { text: CardapioStore.n-result-code; color: Theme.text; font-size: 16px; font-weight: 900; font-family: "Menlo"; horizontal-stretch: 1; }
                    Pill { text: "VÁLIDO NA SEFAZ"; tone: Theme.available; }
                }
                FieldLabel { text: "DESCRIÇÃO OFICIAL"; }
                Text { text: CardapioStore.n-result-desc; color: Theme.text; font-size: 13px; font-weight: 600; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    for tax in [{ label: "Imposto Federal", value: CardapioStore.n-fed }, { label: "Imposto Estadual", value: CardapioStore.n-est }]: Rectangle {
                        horizontal-stretch: 1;
                        height: 54px;
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.surface-2;
                        VerticalLayout {
                            padding: 9px;
                            Text { text: "% " + tax.label; color: Theme.text-muted; font-size: 12px; }
                            Text { text: tax.value; color: Theme.text; font-size: 13px; font-weight: 800; font-family: "Menlo"; }
                        }
                    }
                }
                Btn { text: "Usar este NCM no Produto"; fill: Theme.purple; tone: #ffffff; weight: 800; clicked => { CardapioStore.n-use(); } }
            }
        }
        // Resultados da pesquisa pelo nome (toque abre a consulta oficial do código)
        if CardapioStore.n-results.length > 0: VerticalLayout {
            spacing: 6px;
            FieldLabel { text: CardapioStore.n-total-label; }
            lista := Flickable {
                height: min(lista-col.preferred-height, 300px);
                content-height: lista-col.preferred-height;
                lista-col := VerticalLayout {
                    width: lista.width;
                    spacing: 4px;
                    for r in CardapioStore.n-results: Rectangle {
                        height: linha.preferred-height;
                        border-radius: 10px;
                        background: lt.has-hover ? Theme.surface-2 : Theme.bg;
                        border-width: CardapioStore.n-has-result && CardapioStore.n-result-code == r.codigo ? 2px : 0px;
                        border-color: Theme.purple;
                        linha := HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;
                            Text { text: r.codigo; color: Theme.purple; font-size: 14px; font-weight: 800; font-family: "Menlo"; min-width: 84px; }
                            Text { text: r.descricao; color: Theme.text; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; max-height: 54px; overflow: elide; }
                        }
                        lt := TouchArea { mouse-cursor: pointer; clicked => { CardapioStore.n-quick(r.codigo); } }
                    }
                }
            }
            if CardapioStore.n-more: Btn {
                text: CardapioStore.n-loading ? "Carregando..." : "Carregar mais resultados";
                enabled: !CardapioStore.n-loading;
                clicked => { CardapioStore.n-more-load(); }
            }
        }
    }
}

// ---------- Folha de balanço ----------
component SheetModal inherits Sheet {
    panel-width: 540px;
    icon: CardapioIcons.clipboard-list;
    tone: Theme.occupied;
    title: "Folha de Balanço (PDF)";
    subtitle: "Imprima, anote a contagem e os preços novos à mão e depois lance no sistema.";
    close => { CardapioStore.close-modal(); }
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        FieldLabel { text: "CATEGORIA"; }
        ComboBox {
            height: 40px;
            model: CardapioStore.s-category-labels;
            current-index <=> CardapioStore.s-category-index;
            selected => { CardapioStore.s-changed(); }
        }
        FieldLabel { text: "ORDEM"; }
        HorizontalLayout {
            spacing: 8px;
            for o in [{ alpha: true, label: "Alfabética", hint: "Todos os produtos de A a Z" }, { alpha: false, label: "Por categoria", hint: "Agrupado por categoria, A a Z dentro de cada uma" }]: Rectangle {
                horizontal-stretch: 1;
                height: ob.preferred-height;
                border-radius: 12px;
                border-width: 1px;
                border-color: CardapioStore.s-alpha == o.alpha ? Theme.primary : Theme.border;
                background: CardapioStore.s-alpha == o.alpha ? Theme.primary.with-alpha(0.1) : transparent;
                ob := VerticalLayout {
                    padding: 10px;
                    Text { text: o.label; color: Theme.text; font-size: 13px; font-weight: 800; }
                    Text { text: o.hint; color: Theme.text-muted; font-size: 13px; wrap: word-wrap; }
                }
                TouchArea { clicked => { CardapioStore.s-alpha = o.alpha; CardapioStore.s-changed(); } }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Check { y: (parent.height - self.height) / 2; checked: CardapioStore.s-show-cost; clicked => { CardapioStore.s-show-cost = !CardapioStore.s-show-cost; } }
            Text { text: "Mostrar preço de custo (desmarque se a folha for para funcionários)"; color: Theme.text; font-size: 13px; wrap: word-wrap; horizontal-stretch: 1; }
        }
        Text {
            text: "A folha traz código, produto, unidade, estoque atual, Contagem em branco, " + (CardapioStore.s-show-cost ? "custo, " : "") + "preço atual e Novo preço em branco.";
            color: Theme.text-muted;
            font-size: 13px;
            wrap: word-wrap;
        }
        if CardapioStore.s-feedback != "": Text { text: CardapioStore.s-feedback; color: CardapioStore.s-error ? Theme.danger : Theme.available; font-size: 13px; font-weight: 700; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn { text: "Fechar"; clicked => { CardapioStore.close-modal(); } }
            Btn {
                text: CardapioStore.s-count == 0 ? "Nenhum produto" : "Gerar PDF (" + CardapioStore.s-count + " produtos)";
                icon: Icons.printer;
                has-icon: true;
                fill: Theme.primary;
                tone: Theme.primary-text;
                weight: 900;
                enabled: CardapioStore.s-count > 0;
                busy: CardapioStore.s-busy;
                clicked => { CardapioStore.s-export(); }
            }
        }
    }
}

// ---------- Fornecedor rápido ----------
component QuickSupplierSheet inherits Sheet {
