    out property <image> sparkles: @image-url("../../assets/icons/sparkles.svg");
    out property <image> arrow-up-circle: @image-url("../../assets/icons/circle-arrow-up.svg");
    out property <image> refresh: @image-url("../../assets/icons/refresh-cw.svg");
    out property <image> key: @image-url("../../assets/icons/key.svg");
    out property <image> trending-up: @image-url("../../assets/icons/trending-up.svg");
    out property <image> folder-open: @image-url("../../assets/icons/folder-open.svg");
    out property <image> loader: @image-url("../../assets/icons/loader-circle.svg");
    out property <image> qr-code: @image-url("../../assets/icons/qr-code.svg");
    out property <image> external-link: @image-url("../../assets/icons/external-link.svg");
    out property <image> copy: @image-url("../../assets/icons/copy.svg");
    out property <image> list-checks: @image-url("../../assets/icons/list-checks.svg");
    out property <image> send: @image-url("../../assets/icons/send.svg");
    out property <image> arrow-left: @image-url("../../assets/icons/arrow-left.svg");
    out property <image> calendar: @image-url("../../assets/icons/calendar.svg");
    out property <image> award: @image-url("../../assets/icons/award.svg");
    out property <image> receipt: @image-url("../../assets/icons/receipt.svg");
    out property <image> dollar: @image-url("../../assets/icons/dollar-sign.svg");
    out property <image> clock: @image-url("../../assets/icons/clock.svg");
    out property <image> info: @image-url("../../assets/icons/info.svg");
    out property <image> settings-2: @image-url("../../assets/icons/settings-2.svg");
    out property <image> sliders: @image-url("../../assets/icons/sliders-horizontal.svg");
    out property <image> maximize: @image-url("../../assets/icons/maximize-2.svg");
    out property <image> scissors: @image-url("../../assets/icons/scissors.svg");
    out property <image> rotate-ccw: @image-url("../../assets/icons/rotate-ccw.svg");
    out property <image> check: @image-url("../../assets/icons/check.svg");
