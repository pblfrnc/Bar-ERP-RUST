    out property <image> users: @image-url("../../assets/icons/users.svg");
    out property <image> smartphone: @image-url("../../assets/icons/smartphone.svg");
    out property <image> printer: @image-url("../../assets/icons/printer.svg");
    out property <image> chevron-right: @image-url("../../assets/icons/chevron-right.svg");
    out property <image> chevron-left: @image-url("../../assets/icons/chevron-left.svg");
    out property <image> chevron-down: @image-url("../../assets/icons/chevron-down.svg");
    out property <image> chevron-up: @image-url("../../assets/icons/chevron-up.svg");
    out property <image> shield-check: @image-url("../../assets/icons/shield-check.svg");
    out property <image> shield-alert: @image-url("../../assets/icons/shield-alert.svg");
    out property <image> monitor-smartphone: @image-url("../../assets/icons/monitor-smartphone.svg");
    out property <image> wifi: @image-url("../../assets/icons/wifi.svg");
    out property <image> building: @image-url("../../assets/icons/building-2.svg");
    out property <image> truck: @image-url("../../assets/icons/truck.svg");
    out property <image> chart: @image-url("../../assets/icons/chart-column.svg");
    out property <image> sun: @image-url("../../assets/icons/sun.svg");
    out property <image> moon: @image-url("../../assets/icons/moon.svg");
