// Cores que o original usa e que não estão no Theme
export global RtColors {
    out property <color> indigo: Theme.dark ? #818cf8 : #4f46e5;       // indigo-400 / 600
    out property <color> indigo-solid: #4f46e5;                        // indigo-600
    out property <color> emerald-solid: #059669;                       // emerald-600
    out property <color> cyan: Theme.dark ? #22d3ee : #06b6d4;          // cyan-400 / 500
    out property <color> rose: Theme.dark ? #fb7185 : #e11d48;          // rose-400 / 600
}

export component RIcon inherits Image {
    in property <color> tint: Theme.text;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    colorize: root.tint;
    image-fit: contain;
}

export component Spinner inherits Rectangle {
    in property <color> tint: Theme.text;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    RIcon {
        source: RtIcons.loader;
        tint: root.tint;
        size: root.size;
        transform-rotation: mod(animation-tick() / 1ms, 900) / 900 * 360deg;
    }
}

// Botão com cor própria (fundo, texto e borda)
export component RButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> spin;
    in property <color> bg: Theme.surface-2;
    in property <color> fg: Theme.text;
    in property <color> hover-bg: self.bg.brighter(0.12);
    in property <color> outline: transparent;
    in property <bool> enabled: true;
    in property <length> font-size: 12px;
    in property <int> weight: 800;
    in property <length> pad: 16px;
    callback clicked;
    min-height: 38px;
    min-width: row.preferred-width + 2 * root.pad;
    border-radius: 12px;
    border-width: root.outline == transparent ? 0 : 1px;
    border-color: root.outline;
    opacity: root.enabled ? 1 : 0.5;
    background: touch.has-hover && root.enabled ? root.hover-bg : root.bg;
    row := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        if root.spin: VerticalLayout { alignment: center; Spinner { tint: root.fg; size: root.font-size + 3px; } }
        if !root.spin && root.icon.width > 0: VerticalLayout { alignment: center; RIcon { source: root.icon; tint: root.fg; size: root.font-size + 3px; } }
        if root.text != "": Text { text: root.text; color: root.fg; font-size: root.font-size; font-weight: root.weight; vertical-alignment: center; }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Botão âmbar principal (Salvar)
export component PrimaryButton inherits RButton {
    bg: Theme.primary;
    fg: #020617;
    hover-bg: #fbbf24;
    weight: 900;
}

// Botão neutro (cinza)
export component GhostButton inherits RButton {
    bg: Theme.surface-2.with-alpha(Theme.dark ? 1 : 0.7);
    fg: Theme.text;
    hover-bg: Theme.border;
}

// Campo de texto no tema do app
export component RInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <length> font-size: 13px;
    in property <int> weight: 500;
    in property <bool> mono;
    in property <TextHorizontalAlignment> align: left;
    in property <string> suffix;
    in property <color> focus-color: Theme.primary;
    callback accepted();
    callback edited(string);
    forward-focus: input;
    min-height: 40px;
    border-radius: 12px;
    border-width: 1px;
    border-color: input.has-focus ? root.focus-color : Theme.border;
    background: Theme.bg;
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { input.focus(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        Rectangle {
            horizontal-stretch: 1;
            Text {
                x: 0;
                width: 100%;
                text: input.text == "" ? root.placeholder : "";
                color: Theme.text-muted;
                font-size: root.font-size;
                font-family: root.mono ? "Menlo" : "";
                vertical-alignment: center;
                horizontal-alignment: root.align;
                overflow: elide;
            }
            input := TextInput {
                width: 100%;
                color: Theme.text;
                font-size: root.font-size;
                font-weight: root.weight;
                font-family: root.mono ? "Menlo" : "";
                vertical-alignment: center;
                horizontal-alignment: root.align;
                single-line: true;
                selection-background-color: Theme.primary.with-alpha(0.4);
                accepted => { root.accepted(); }
                edited => { root.edited(self.text); }
            }
        }
        if root.suffix != "": Text { text: root.suffix; color: Theme.text-muted; font-size: 12px; font-weight: 700; vertical-alignment: center; }
    }
}

// Chave liga/desliga (role="switch" do original)
export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <color> tone: Theme.primary;
    callback toggled;
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: root.on ? root.tone : (Theme.dark ? #334155 : #cbd5e1);
    Rectangle {
        x: root.on ? 22px : 2px;
        y: 2px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
        animate x { duration: 150ms; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

// Chave com o texto ao lado
export component ToggleRow inherits HorizontalLayout {
    in property <bool> on;
    in property <string> text;
    in property <color> tone: Theme.primary;
    callback toggled;
    spacing: 12px;
    alignment: start;
    VerticalLayout { alignment: center; Toggle { on: root.on; tone: root.tone; toggled => { root.toggled(); } } }
    Text { text: root.text; color: Theme.text; font-size: 12px; font-weight: 700; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
}

// Caixa de seleção (checkbox do original)
export component CheckBox inherits Rectangle {
    in property <bool> checked;
    callback toggled;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    border-width: 2px;
    border-color: root.checked ? Theme.primary : Theme.border;
    background: root.checked ? Theme.primary : Theme.bg;
    if root.checked: RIcon { source: RtIcons.check; tint: #020617; size: 14px; }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(); } }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 24px;
    border-width: 1px;
    border-color: Theme.surface-2;
}

// Selo pequeno em maiúsculas (ex.: "PROTEGIDO", "NO AR")
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.primary;
    in property <bool> pill;
    height: 20px;
    width: bt.preferred-width + 14px;
    border-radius: root.pill ? 10px : 5px;
    background: root.tone.with-alpha(0.14);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.32);
    bt := Text { text: root.text; color: root.tone; font-size: 10px; font-weight: 900; letter-spacing: 0.4px; }
}

// Ícone num círculo (ou quadrado arredondado) com fundo da cor em 10%
export component IconBubble inherits Rectangle {
    in property <image> icon;
    in property <color> tone: Theme.primary;
    in property <length> size: 48px;
    in property <bool> square;
    in property <bool> outlined;
    width: root.size;
    height: root.size;
    border-radius: root.square ? root.size * 0.33 : root.size / 2;
    background: root.tone.with-alpha(0.12);
    border-width: root.outlined ? 1px : 0;
    border-color: root.tone.with-alpha(0.25);
    RIcon { source: root.icon; tint: root.tone; size: root.size / 2; }
}

// Cartão-botão da Retaguarda: ícone, título, subtítulo e seta (">")
export component NavCard inherits Rectangle {
    in property <image> icon;
    in property <color> tone: Theme.primary;
    in property <string> title;
    in property <string> subtitle;
    callback clicked;
    min-height: 88px;
    border-radius: 24px;
    border-width: 1px;
    border-color: Theme.surface-2;
    background: touch.has-hover ? (Theme.dark ? #1e293b : #f8fafc) : Theme.surface;
    HorizontalLayout {
        padding: 20px;
        spacing: 16px;
        VerticalLayout { alignment: center; IconBubble { icon: root.icon; tone: root.tone; } }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; color: touch.has-hover ? root.tone : Theme.text; font-size: 15px; font-weight: 700; wrap: word-wrap; }
            Text { text: root.subtitle; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout { alignment: center; RIcon { source: RtIcons.chevron-right; tint: touch.has-hover ? root.tone : Theme.text-muted; size: 20px; } }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Rótulo de campo
export component FieldLabel inherits Text {
    color: Theme.text-muted;
    font-size: 12px;
    font-weight: 700;
}

// Mensagem de retorno com ícone (verde ok, vermelho erro)
export component Feedback inherits HorizontalLayout {
    in property <string> text;
    in property <bool> ok;
    spacing: 8px;
    VerticalLayout { alignment: start; RIcon { source: root.ok ? RtIcons.circle-check : RtIcons.alert; tint: root.ok ? Theme.available : Theme.danger; size: 16px; } }
    Text { text: root.text; color: root.ok ? Theme.available : Theme.danger; font-size: 12px; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; }
}

// Faixa de alerta vermelha
export component AlertBox inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.danger;
    border-radius: 16px;
    background: root.tone.with-alpha(0.1);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.3);
    HorizontalLayout {
        padding: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        VerticalLayout { alignment: start; RIcon { source: RtIcons.alert; tint: root.tone; size: 16px; } }
        Text { text: root.text; color: root.tone; font-size: 12px; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; }
    }
}

// Barra de progresso horizontal (gráficos do dashboard)
export component ProgressBar inherits Rectangle {
    in property <float> pct; // 0..100
    in property <color> tone: Theme.primary;
    height: 8px;
    border-radius: 4px;
    background: Theme.dark ? #020617 : #f1f5f9;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.pct, 0, 100) / 100;
        height: parent.height;
        border-radius: 4px;
        background: root.tone;
    }
}

// Cabeçalho de seção numerada (Impressoras)
export component SectionTitle inherits HorizontalLayout {
    in property <image> icon;
    in property <string> text;
    spacing: 10px;
    VerticalLayout { alignment: center; RIcon { source: root.icon; tint: Theme.primary; size: 20px; } }
    Text { text: root.text; color: Theme.text; font-size: 13px; font-weight: 900; letter-spacing: 0.6px; vertical-alignment: center; }
}

// Botão de voltar (seta)
export component BackButton inherits Rectangle {
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.border : Theme.surface-2;
    RIcon { source: RtIcons.arrow-left; tint: Theme.text; size: 20px; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
