// Página "retaguarda" (port completo da área correspondente do app original): SettingsView, DashboardView com
// AuditView, PrinterSettingsView e SubscriptionView. O estado e os callbacks ficam no global `RetaguardaStore`
// (`retaguarda_store.slint`), ligado em `src/pages/retaguarda.rs`. A tela de ativação (`LicenseGate`) e o aviso de
// mensalidade (`LicenseInfoModal`) ficam por cima do app inteiro, no app.slint.

import { Theme } from "../theme.slint";
import { RetaguardaStore, RtView } from "retaguarda_store.slint";
import { RtIcons, RIcon, PrimaryButton, GhostButton } from "retaguarda_widgets.slint";
import { RetaguardaHub } from "retaguarda_hub.slint";
import { RetaguardaDashboard } from "retaguarda_dash.slint";
import { RetaguardaPrinters } from "retaguarda_printers.slint";
import { RetaguardaSubscription, LicenseGate, LicenseInfoModal } from "retaguarda_license.slint";
import { CustomersScreen, SuppliersScreen } from "cardapio_people.slint";
import { CardapioModals } from "cardapio_modals.slint";
import { TeamModals } from "mesas_modals.slint";

export { RetaguardaStore, LicenseGate, LicenseInfoModal }

component MessageBox inherits Rectangle {
    in property <string> text;
    in property <bool> confirm;
    callback ok;
    callback cancel;
    background: Theme.overlay;
    TouchArea { }
    Rectangle {
        width: min(440px, root.width - 40px);
        height: col.preferred-height;
        border-radius: 20px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        col := VerticalLayout {
            padding: 20px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout { alignment: start; RIcon { source: root.confirm ? RtIcons.circle-alert : RtIcons.info; tint: root.confirm ? Theme.primary : Theme.text-muted; size: 22px; } }
                Text { text: root.text; color: Theme.text; font-size: 14px; wrap: word-wrap; horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                if root.confirm: GhostButton { text: "Cancelar"; clicked => { root.cancel(); } }
                PrimaryButton { text: "OK"; clicked => { root.ok(); } }
            }
        }
    }
}

// Item do menu lateral da Retaguarda (acesso direto a cada parte, sem passar pela tela inicial)
component SideItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    in property <bool> icon-only;
    // Selo à direita: "!" (alerta) ou dias da assinatura
    in property <string> badge;
    in property <color> badge-tone: Theme.danger;
    callback clicked;
    height: 44px;
    border-radius: 10px;
    background: root.active ? Theme.primary : (touch.has-hover ? Theme.surface-2 : transparent);
    HorizontalLayout {
        padding-left: root.icon-only ? 0 : 12px;
        padding-right: root.icon-only ? 0 : 10px;
        spacing: 10px;
        alignment: root.icon-only ? center : stretch;
        VerticalLayout { alignment: center; RIcon { source: root.icon; tint: root.active ? #020617 : (touch.has-hover ? Theme.text : Theme.text-muted); size: 18px; } }
        if !root.icon-only: Text {
            text: root.text;
            color: root.active ? #020617 : Theme.text;
            font-size: 15px;
            font-weight: root.active ? 900 : 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if !root.icon-only && root.badge != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 22px;
                width: max(22px, bt.preferred-width + 12px);
                border-radius: 11px;
                background: root.badge-tone.with-alpha(0.2);
                bt := Text { text: root.badge; color: root.badge-tone; font-size: 12px; font-weight: 900; }
            }
        }
    }
    if root.icon-only && root.badge != "": Rectangle {
        x: parent.width - 14px;
        y: 6px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.badge-tone;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SideGroup inherits Text {
    color: Theme.text-muted;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
}

export component RetaguardaAreaPage inherits Rectangle {
    background: Theme.bg;
    // Janela estreita: o menu lateral fica só com os ícones
    property <bool> icons-only: root.width < 1100px;
    property <RtView> view: RetaguardaStore.view;

    HorizontalLayout {
        // Menu lateral agrupado
        Rectangle {
            width: root.icons-only ? 68px : 248px;
            background: Theme.surface;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.surface-2; }
            VerticalLayout {
                padding: 12px;
                padding-right: 13px;
                spacing: 2px;
                alignment: start;
                if !root.icons-only: SideGroup { text: "GESTÃO"; }
                SideItem { icon: RtIcons.settings; text: "Visão geral"; icon-only: root.icons-only; active: root.view == RtView.hub; badge: RetaguardaStore.b-alert-on ? "!" : ""; clicked => { RetaguardaStore.back(); } }
                SideItem { icon: RtIcons.chart; text: "Painel"; icon-only: root.icons-only; active: root.view == RtView.dashboard; clicked => { RetaguardaStore.open-dashboard(); } }
                if !root.icons-only: Rectangle { height: 10px; }
                if !root.icons-only: SideGroup { text: "CADASTROS"; }
                SideItem { icon: RtIcons.shield-check; text: "Equipe e permissões"; icon-only: root.icons-only; clicked => { RetaguardaStore.open-staff(); } }
                SideItem { icon: RtIcons.users; text: "Garçons"; icon-only: root.icons-only; clicked => { RetaguardaStore.open-waiters(); } }
                SideItem { icon: RtIcons.credit-card; text: "Clientes (fiado)"; icon-only: root.icons-only; active: root.view == RtView.customers; clicked => { RetaguardaStore.open-customers(); } }
                SideItem { icon: RtIcons.truck; text: "Fornecedores"; icon-only: root.icons-only; active: root.view == RtView.suppliers; clicked => { RetaguardaStore.open-suppliers(); } }
                if !root.icons-only: Rectangle { height: 10px; }
                if !root.icons-only: SideGroup { text: "CONFIGURAÇÕES"; }
                SideItem { icon: RtIcons.printer; text: "Impressoras"; icon-only: root.icons-only; active: root.view == RtView.printers; clicked => { RetaguardaStore.open-printers(); } }
                SideItem { icon: RtIcons.smartphone; text: "Conectar celular"; icon-only: root.icons-only; clicked => { RetaguardaStore.open-connect(); } }
                SideItem {
                    icon: RtIcons.key;
                    text: "Assinatura";
                    icon-only: root.icons-only;
                    active: root.view == RtView.subscription;
                    badge: RetaguardaStore.s-days > 0 && RetaguardaStore.s-days <= 7 ? RetaguardaStore.s-days + "d" : "";
                    badge-tone: Theme.closing;
                    clicked => { RetaguardaStore.open-subscription(); }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.view == RtView.hub: RetaguardaHub { width: 100%; height: 100%; }
            if root.view == RtView.dashboard: RetaguardaDashboard { width: 100%; height: 100%; }
            if root.view == RtView.printers: RetaguardaPrinters { width: 100%; height: 100%; }
            if root.view == RtView.subscription: RetaguardaSubscription { width: 100%; height: 100%; }
            if root.view == RtView.customers: VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 12px;
                CustomersScreen { show-back: true; back => { RetaguardaStore.back(); } }
            }
            if root.view == RtView.suppliers: VerticalLayout {
                width: 100%;
                height: 100%;
                padding-top: 12px;
                SuppliersScreen { show-back: true; back => { RetaguardaStore.back(); } }
            }
        }
    }

    // Cadastro de cliente, pagamento do fiado e cadastro de fornecedor (os mesmos modais da área Cardápio)
    if root.view == RtView.customers || root.view == RtView.suppliers: CardapioModals { width: 100%; height: 100%; }
    // Garçons, funcionários e conectar celular (os mesmos modais da área Mesas)
    TeamModals { width: 100%; height: 100%; }

    if RetaguardaStore.confirm-text != "": MessageBox {
        width: 100%;
        height: 100%;
        text: RetaguardaStore.confirm-text;
        confirm: true;
        ok => {
            RetaguardaStore.confirm-text = "";
            RetaguardaStore.confirm-accepted(RetaguardaStore.confirm-action);
        }
        cancel => { RetaguardaStore.confirm-text = ""; }
    }
    if RetaguardaStore.alert-text != "": MessageBox {
        width: 100%;
        height: 100%;
        text: RetaguardaStore.alert-text;
        ok => { RetaguardaStore.alert-text = ""; }
    }
}
