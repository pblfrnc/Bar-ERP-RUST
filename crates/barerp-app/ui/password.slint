// Troca da própria senha (botão "Trocar senha" na barra superior).

import { LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value <=> edit.text;
    callback accepted;
    spacing: 6px;
    Text { text: root.label; color: Theme.text-muted; font-size: 13px; font-weight: 600; }
    edit := LineEdit {
        input-type: password;
        height: 44px;
        accepted => { root.accepted(); }
    }
    public function focus-edit() { edit.focus(); }
}

export component ChangePasswordDialog inherits Rectangle {
    in property <string> hint;
    in property <string> error;
    in property <bool> busy;
    callback save(string, string, string);
    callback cancel();

    background: Theme.overlay;

    // Clique fora do painel não fecha (evita perder o que foi digitado)
    TouchArea { }

    function send() {
        if (!root.busy) { root.save(current.value, new-password.value, confirm.value); }
    }

    Rectangle {
        width: 440px;
        height: layout.preferred-height;
        background: Theme.surface;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border;

        layout := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text { text: "Trocar senha"; color: Theme.text; font-size: 22px; font-weight: 800; }
            if root.hint != "": Rectangle {
                height: hint-text.preferred-height + 20px;
                border-radius: 10px;
                background: Theme.primary.with-alpha(0.12);
                hint-text := Text {
                    x: 12px;
                    width: parent.width - 24px;
                    text: root.hint;
                    color: Theme.primary;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
            current := Field { label: "Senha atual"; accepted => { new-password.focus-edit(); } }
            new-password := Field { label: "Nova senha (mínimo 4 caracteres)"; accepted => { confirm.focus-edit(); } }
            confirm := Field { label: "Repita a nova senha"; accepted => { root.send(); } }
            if root.error != "": Text { text: root.error; color: Theme.danger; font-size: 13px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Rectangle {
                    width: 120px;
                    height: 44px;
                    border-radius: 10px;
                    background: cancel-touch.has-hover ? Theme.border : Theme.surface-2;
                    Text { text: "Cancelar"; color: Theme.text; font-weight: 700; }
                    cancel-touch := TouchArea { clicked => { root.cancel(); } }
                }
                Rectangle {
                    width: 160px;
                    height: 44px;
                    border-radius: 10px;
                    background: Theme.primary;
                    Text { text: root.busy ? "Salvando…" : "Salvar senha"; color: Theme.primary-text; font-weight: 800; }
                    TouchArea { clicked => { root.send(); } }
                }
            }
        }
    }

    init => { current.focus-edit(); }
}
